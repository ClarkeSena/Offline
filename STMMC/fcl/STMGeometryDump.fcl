# Dump STM detector geometry (crystal centres, dimensions, transforms).
# Runs one event through G4 to initialize geometry, then prints a summary.

#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardProducers.fcl"
#include "Offline/fcl/standardServices.fcl"

process_name : STMGeomDump

source : { module_type : EmptyEvent maxEvents : 1 }

services : @local::Services.Sim

physics : {
   producers : {
      generate : {
         module_type : ExtMonFNALGun
         guns : [ { reference : "detector" } ]
      }
      g4run : @local::g4run
   }

   analyzers : {
      stmDump : { module_type : STMGeometryDump }
   }

   p1 : [ generate, g4run ]
   e1 : [ stmDump ]

   trigger_paths : [ p1 ]
   end_paths     : [ e1 ]
}

physics.producers.g4run.physics.physicsListName : "Minimal"
physics.producers.g4run.SDConfig.enableSD       : []

services.SeedService.baseSeed        : 8
services.SeedService.maxUniqueEngines : 20

#
# prolog.fcl for fcl paramaters that will be used in STM simulation modules
#

#include "Offline/STMReco/fcl/prolog.fcl"
BEGIN_PROLOG

# Geometry, all in mm
ComponentPositions : { # In beam order
    Beam : {
        x : -3904.0
        y : 0.0
    }
    Absorber : { # 50mm x 50mm x 390mm
        x : -3944.6
        y : -24.9 # TODO - why is this not 0.0?
        z : 39900
    }
    VD101 : { # Centre
        x : -3904.0
        y : 0.0
        z : 40301.0
    }
    HPGe : { # aperture centre
        x : -3944.6
        y : 0.0
        z : 40404
    }
    HPGeCrystalEndcapCentre : {
        x : -3942.15
        y : 0
        z : 40677.44
    }
    LaBr : { # aperture centre
        x : -3863.4
        y : 0.0
    }
}

# Stage 1 propagation parameters
ResamplingProducer : {
    StepPointMCsTag : "g4run:virtualdetector"
    VirtualDetectorID : 101
}
ResamplingFilter : {
    StepPointMCsTag : "compressDetStepMCsSTM"
}
VirtualDetectorCounter : {
    StepPointMCsTag : "g4run:virtualdetector"
    virtualDetectorIDs : [88, 89, 90, 100, 101]
}

# ShiftVirtualDetectorStepPointMCs_module.cc parameters
ShiftVD101Steps : {
    StepPointMCsTag : "compressDetStepMCsSTM:virtualdetector"
    VirtualDetectorID : 101
    InputRadius : 200 # VD101 aperture radius
    OutputRadius : 3.98942280401 # SSC aperture radius
    HPGeUpStr : { # Position just upstream of absorber centered on the HPGe SSC aperture
        x : -3944.6
        y : 0.0
        z : 39906.0
    }
    LaBrUpStr : { # Position just upstream of SSC centered on the Labr SSC aperture
        x : -3863.4
        y : 0.0
        z : 40300.9
    }
    pdgID : 0
}

# Mixing parameters
MixSTMEvents : {
    extendedMean2BB : 3.93e7 # Copied from Production/JobConfig/mixing/TwoBB.fcl
    cutMax2BB : 2.36e8 # Copied from Production/JobConfig/mixing/TwoBB.fcl
    extendedMean1BB : 1.58e7 # Copied from Production/JobConfig/mixing/OneBB.fcl
    cutMax1BB : 9.48e7 # Copied from Production/JobConfig/mixing/OneBB.fcl
    SDF : 0.6
    nPOTs : 26919873604557116
    nMicroSpills : 690253169
    meanEventsPerPOTFactors : {
        EleBeamCat : 5.465876332164181e-11
        MuBeamCat : 7.887481312841522e-13
        TargetStopsCat1809 : 3.114418308224206e-16
    }
}
STMMCAnalysis : {
    MixedEventsTags : {
        StepPointMCsTagEle : "STMStepMixerEle:STMDet"
        StepPointMCsTagMu : "STMStepMixerMu:STMDet"
        StepPointMCsTag1809 : "STMStepMixer1809:STMDet"
    }
    ZS : {
        HPGe : {
            stmWaveformDigisTag : {
                concatenated : "concatenateWaveformsHPGe:"
                uSpill : "DigiHPGe:HPGe"
            }
            tbefore : @local::STM.HPGe.tbefore
            tafter : @local::STM.HPGe.tafter
            threshold : @local::STM.HPGe.threshold
            window : @local::STM.HPGe.window # TODO - when using the optimized number from STMReco, the gradients were fluctuating between the minimum band of an int16_t and 0, but this disappeared when set to 50. Figure out why.
            naverage : @local::STM.HPGe.naverage
        }
        LaBr : {
            stmWaveformDigisTag : "DigiLaBr:LaBr"
            tbefore : @local::STM.LaBr.tbefore
            tafter : @local::STM.LaBr.tafter
            threshold : @local::STM.HPGe.threshold
            window : @local::STM.HPGe.window
            naverage : @local::STM.HPGe.naverage
        }
    }
    PH : {
        HPGe : {
            stmWaveformDigisTag : {
                ZS: "ZSHPGe:"
                concatenated: "concatenateWaveformsHPGe:"
            }
            tau : @local::STM.HPGe.tau
            M : @local::STM.HPGe.M
            L : @local::STM.HPGe.L
            nsigma_cut : @local::STM.HPGe.nsigma_cut
            thresholdgrad : @local::STM.HPGe.thresholdgrad
            defaultBaselineMean : { # TODO - this should be the pedestal
                full : @local::STM.HPGe.defaultBaselineMean
                suppressed : 0
            }
            defaultBaselineSD : { # TODO - this should be NoiseSD converted to ADC bins
                full: @local::STM.HPGe.defaultBaselineSD
                suppressed: 0
            }
            STMPHDigiTag : "PHHPGe:"
        }
        LaBr : {
            stmWaveformDigisTag : "ZSLaBr:"
            tau : @local::STM.HPGe.tau
            M : @local::STM.HPGe.M
            L : @local::STM.HPGe.L
            nsigma_cut : @local::STM.HPGe.nsigma_cut
            thresholdgrad : @local::STM.HPGe.thresholdgrad
            defaultBaselineMean : @local::STM.HPGe.defaultBaselineMean
            defaultBaselineSD : @local::STM.HPGe.defaultBaselineSD
            STMPHDigiTag : "PHLaBr:"
        }
    }
}

# MakeTree_module.cc parameters
SimplifyStage1Data : {
    StepPointMCsTag : "compressDetStepMCsSTM:"
    StepPointMCsTag1809 : "compressDetStepMCsSTM:virtualdetector"
    SimParticlemvTag : "compressDetStepMCsSTM:"
    VirtualDetectorID : 101
}
SimplifyStage2Data : {
    StepPointMCsTagSTMDet : "compressSTMDet:STMDet"
    StepPointMCsTagVirtualdetector : "compressSTMDet:virtualdetector"
    SimParticlemvTag : "compressSTMDet:"
    VirtualDetectorID : {
        HPGe : 90
        LaBr : 89
    }
    DetectorName : {
        HPGe : "HPGe"
        LaBr : "LaBr"
    }
}

# DAQ parameters
STMDAQParameters : {
    samplingFrequencies : {
        HPGe : 320 # MSPS - copied from Offline/STMConditions/fcl/prolog.fcl
        LaBr : 370.370370370 # MSPS - copied from Offline/STMConditions/fcl/prolog.fcl
    }
}
LaBrDigitization : {
    # Detector response from the Mu2e ELBE test-beam qualification of the
    # LaBr3:Ce+Sr / Hamamatsu R10233-100 detector (Huang et al., NIM A).
    EnergyPerADCBin : 0.5 # keV/bin
    PreamplifierNoiseSD : 0.32 # mV
    DecayConstant : 0.05 # us (50 ns preamplifier decay, much shorter than HPGe)
    # Pulse shape (1-exp(-t/tau1))^p * exp(-t/tau2), fitted to real LaBr3 data
    pulseTau1 : 22.3543 # ns - rise time constant
    pulseTau2 : 28.0007 # ns - decay time constant
    pulseRiseSharpening : 6.6596 # rise sharpening exponent p
    peakKeVPerADC : 0.57 # keV/ADC - peak-height calibration from source data (energy = 0.57 * ADC_peak); overrides EnergyPerADCBin
    lightYield : 63000 # photons/MeV
    quantumEfficiency : 0.35 # PMT super-bialkali quantum efficiency (~35%)
    excessNoiseFactor : 1.27 # PMT dynode-chain excess noise; reproduces 2.2% FWHM at 662 keV
    # Alpha light quenching (Ac-227 chain): QF(E0) = alphaQuenchingFactor
    # + alphaQuenchingSlope * (E0 - 6 MeV). Use the SAME values on the digitizer and on
    # LaBrTruthPulses / LaBrTruthSpectrum.
    # SOURCE: Mu2e LaBr3:Ce+Sr bench data, Eu-152 runs 125382 / 125385 (2026-10-19), analysed
    # with labrSelfActivity.py. Fitted to the alpha lines that go to the daughter ground state
    # (no coincident gamma): Bi-211 6.623 -> 3.11, Rn-219 6.819 -> 3.22, Po-215 7.386 -> 3.56
    # MeV electron-equivalent (QF 0.470, 0.472, 0.482). The Ra-223 + Th-227 cluster lands at
    # 2.76 MeV, consistent. Peak positions +-20 keV -> QF +-0.005; energy scale above 1.46 MeV
    # is an extrapolation of the Eu-152 calibration.
    # PREVIOUS: 0.30, slope 0 - from the 1.5-2.4 MeV alpha band of a standard LaBr3:Ce B380
    # crystal (Cheng et al., Nucl. Sci. Tech. 31 (2020) 99, arXiv:2007.07552).
    alphaQuenchingFactor : 0.459 # light ratio at 6 MeV
    alphaQuenchingSlope : 0.016 # per MeV of alpha energy
}
# Intrinsic LaBr3 activity (Bq/cm^3).
#   La-138: LaBrIntrinsicSource / La138Source compute it from the crystal composition
#   (1.454 Bq/cm^3 with 5% Ce, T1/2 1.03e11 yr) unless la138SpecificActivity is set.
#   Ac-227: ac227ChainActivity per chain member, secular equilibrium.
# SOURCE of the measured values: same bench runs and analysis as alphaQuenchingFactor above.
#   La-138: EC sum-peak rate 63.4 +- 0.7 counts/s (run 125382, 1380-1560 keV, Eu-152 1408
#     subtracted) / (ecFraction 0.655 x eps_int 0.1896 from La138InternalEfficiency.fcl)
#     = 511 +- 6 Bq. Run 125385 gives 528 Bq (its live time is suspect). Agrees with the
#     computed value, which is therefore kept as the default.
#   Ac-227: 17.2 +- 0.4 alphas/s in the 2.4-3.8 MeV band (run 125382, sideband-subtracted)
#     = 5 alpha emitters x 0.0099 Bq/cm^3 x 347.5 cm^3. Alpha escape from the surface
#     < 0.1%; no chain beta reaches the band.
LaBrIntrinsicActivity : {
    la138Measured : 1.470 # +- 0.019 stat; bench, see above
    la138Literature : 1.425 # B380 3x3 (Cheng et al., NST 31 (2020) 99); multi-crystal avg 1.488
    ac227Chain : 0.0099 # bench, see above. Was 0.0136 (= ac227ChainLiterature)
    ac227ChainLiterature : 0.0136 # B380 3x3 mean of Th-227/Ra-223/Rn-219/Bi-211 (Cheng 2020); varies ~100x by crystal
}
# Pileup-truth tagging (LaBrTruthPulses -> TagPileupPulses)
# A truth pulse is the total energy one primary deposits in the crystal. Two
# pulses pile up when the later one lands on the decaying tail of the earlier
# (window w_after(E) = pulseTau2 * ln(peakADCPerKeV*E / thresholdADC)) or within
# the fixed rise-side window wBefore of the other.
LaBrPileup : {
    micropulseTime : 1695.0 # ns - must match the digitizer's micropulseTime
    pulseTau2 : 28.0007 # ns - pulse decay constant (same as LaBrDigitization.pulseTau2)
    peakADCPerKeV : 1.7543859649 # ADC/keV = 1 / LaBrDigitization.peakKeVPerADC (0.57)
    thresholdADC : 5.0 # ADC - resolving threshold; set to the ZS/pulse-finder threshold
    wBefore : 20.0 # ns - fixed rise-side pileup window
    minWindow : 20.0 # ns - minimum forward window, applied even to sub-threshold pulses
}
HPGeDigitization : {
    EnergyPerADCBin : 0.5 # keV/bin
    PreamplifierNoiseSD : 0.32 # mV
    FanoFactor : 0.1 # dimensionless; Ge Fano factor at 77 K
    DecayConstant : 50 # us
    resetEventNumber : 31858
    microspillBufferLengthCount : 1000
    concatenation : {
        STMWaveformDigisTag : "DigiHPGe:HPGe"
        nMerge : 31858
        filterTag : "concatenateWaveformsHPGe:"
    }
}

# Normalization parameter determination studies
# Detector efficiency simulation
Efficiency : {
    NPhotons : 1e7
    PhotonEnergy : 1.809 # MeV
    OutputFilename : "Efficiency.root"
}

END_PROLOG
